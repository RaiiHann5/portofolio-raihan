# Salin file ini jadi ".env" lalu isi dengan nilai dari project Supabase Anda:
# Supabase -> Project Settings -> API
#
# Kedua nilai ini memang akan ikut terkirim ke browser pengunjung, dan itu
# normal: anon key dirancang untuk publik. Yang menjaga data adalah Row
# Level Security di supabase/schema.sql.
#
# JANGAN pernah menaruh service_role key di sini.
#
# Kalau kedua baris ini dikosongkan, situs tetap jalan normal memakai data
# dari src/data/*.js dan panel admin otomatis nonaktif.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
